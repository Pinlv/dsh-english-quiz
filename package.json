{
  "name": "dsh-english-quiz",
  "version": "1.0.0",
  "type": "module",
  "description": "English practice inside DeepSeek Harness: multi-blank fill-in, sentence translation, passages and free writing, local grading, wrong-answer follow-up, cross-session statistics, and optional Anki review import.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "license": "MIT",
  "author": "Pinlv",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "english",
    "quiz",
    "language-learning",
    "anki"
  ],
  "repository": "git+https://github.com/Pinlv/dsh-english-quiz.git",
  "homepage": "https://github.com/Pinlv/dsh-english-quiz#readme",
  "bugs": "https://github.com/Pinlv/dsh-english-quiz/issues",
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
